  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "hooklane-prometheus"},
      "description": "API event acceptance request rate.",
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(hooklane_http_requests_total{service=\"api\",route=\"/v1/events\",method=\"POST\"}[5m]))", "refId": "A"}],
      "title": "API request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hooklane-prometheus"},
      "description": "API 4xx and 5xx request rate by bounded status class.",
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum by (status_class) (rate(hooklane_http_requests_total{service=\"api\",route=\"/v1/events\",status_class=~\"4xx|5xx\"}[5m]))", "legendFormat": "{{status_class}}", "refId": "A"}],
      "title": "API error rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hooklane-prometheus"},
      "description": "SLI: valid event enqueue success divided by all enqueue outcomes.",
      "fieldConfig": {"defaults": {"max": 1, "min": 0, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "targets": [{"expr": "sum(rate(hooklane_enqueue_total{service=\"api\",outcome=\"success\"}[5m])) / clamp_min(sum(rate(hooklane_enqueue_total{service=\"api\"}[5m])), 0.000000001)", "refId": "A"}],
      "title": "API acceptance success rate",
      "type": "gauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hooklane-prometheus"},
